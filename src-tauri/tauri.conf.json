{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuseokMemo",
  "version": "0.3.0",
  "identifier": "com.guseok.memo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0Mzc1NUExMUE5NzNERDMKUldUVFBaY2FvVlUzOUZSL3RKWEJNNUdkcS8yZXBqcEtKaW92L1ZjYXNZU0FQQXo3a0ZxZ0RxVXcK",
      "endpoints": ["https://github.com/Logic-k/GuseokMemo/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" },
      "allowDowngrades": true
    }
  }
}

